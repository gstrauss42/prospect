# Copy to .env and fill in. Everything except DEEPSEEK_API_KEY is optional.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Where the app listens and how people reach it
ADDR=127.0.0.1:8080
PUBLIC_URL=http://localhost:8080
DATA_DIR=./data

# Real email through Mailgun (without these, emails are written to DATA_DIR/outbox)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_SENDER_EMAIL=

# Guards
DAILY_SPEND_LIMIT_USD=1.00
MANUAL_RUNS_PER_DAY=6
DEFAULT_FREQUENCY=weekly
MAX_CONCURRENT_RUNS=2
